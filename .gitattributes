# Default: normalize line endings on commit
* text=auto

# Files consumed on Linux (containers, Logstash, bare-metal hosts) MUST be LF
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ndjson text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
.env.example text eol=lf
.gitleaksignore text eol=lf
integrations/sources/**/logrotate-* text eol=lf

# Windows endpoint scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binaries: never convert (and never commit installers; see .gitignore)
*.msi binary
*.exe binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
