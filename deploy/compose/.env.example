# Docker Compose settings. Create .env from this file with ./init-env.sh or .\init-env.ps1;
# values set to __GENERATE__ are replaced with random secrets. .env is git-ignored.

ELASTIC_VERSION=8.13.4

# Superuser "elastic" (log in to Kibana with it)
ELASTIC_PASSWORD=__GENERATE__
# Built-in user Kibana uses to talk to Elasticsearch
KIBANA_SYSTEM_PASSWORD=__GENERATE__
# User the Logstash pipelines write with (role logstash_writer)
LOGSTASH_INGEST_PASSWORD=__GENERATE__
# Kibana saved-object encryption key, at least 32 characters (required by detection rules)
KIBANA_ENCRYPTION_KEY=__GENERATE__

# Delete logs and metrics after this many days
RETENTION_DAYS=90
# Data stream namespace: logs-<dataset>-<namespace>
ES_NAMESPACE=default

# JVM heap sizes
ES_HEAP=1g
LS_HEAP=512m

# Interface Kibana listens on (127.0.0.1 = this machine only, 0.0.0.0 = LAN)
KIBANA_BIND=127.0.0.1
